    {
      "parameters": {
        "jsCode": "const jobs = $input.all();\n\nconst companyCount = {};\nconst locationCount = {};\n\nfor (const item of jobs) {\n\n  const company = item.json[\"Company Name\"] || \"Unknown\";\n  const location = item.json[\"Location\"] || \"Unknown\";\n\n  companyCount[company] = (companyCount[company] || 0) + 1;\n  locationCount[location] = (locationCount[location] || 0) + 1;\n}\n\nfunction topItems(obj, limit = 5) {\n  return Object.entries(obj)\n    .sort((a, b) => b[1] - a[1])\n    .slice(0, limit)\n    .map(([name, count]) => ({\n      name,\n      count\n    }));\n}\n\nreturn [\n  {\n    json: {\n      totalJobs: jobs.length,\n      topCompanies: topItems(companyCount, 5),\n      topLocations: topItems(locationCount, 5)\n    }\n  }\n];"
      },
