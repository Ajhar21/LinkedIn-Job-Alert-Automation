      "parameters": {
        "promptType": "define",
        "text": "=You are a recruitment analyst.\n\nBased on the following hiring statistics, write a professional summary in 2-3 sentences.\nat first, mention the name of the job search keyword: {{ $('Set Input Defaults').item.json.jobTitle }}\nMention for how many job limit set by user: {{ $('Set Input Defaults').item.json.limit }}\nThen start the summary. \n\nTotal Jobs:\n{{ $json.totalJobs }}\n\nTop Hiring Companies:\n{{ JSON.stringify($json.topCompanies) }}\n\nTop Locations:\n{{ JSON.stringify($json.topLocations) }}\n\nYour summary should mention:\n\n• the most common hiring companies\n• the most common hiring locations\n• any noticeable hiring trend\n\nDo not use bullet points.\n\nKeep the response under 70 words.",
        "batching": {}
