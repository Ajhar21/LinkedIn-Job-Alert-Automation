      "parameters": {
        "jsCode": "// Get all jobs from the previous node\nconst jobs = $input.all();\n\n// Transform each job into the desired format\nreturn jobs.map(item => {\n  const job = item.json;\n\n  return {\n    json: {\n      \"Job Title\": job.job_title || \"\",\n      \"Company Name\": job.company_name || \"\",\n      \"Location\": job.location || \"\",\n      \"Posted Time\": job.time_posted || \"\",\n      \"Job URL\": job.apply_url || job.job_url || \"\",\n      \"Company URL\": job.company_url || \"\"\n    }\n  };\n});"
      },
