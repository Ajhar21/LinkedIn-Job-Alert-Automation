# ==========================================
# Environment Variables & Credential Reference
# ==========================================
# Copy this file or reference these variables when configuring n8n credentials.
# NEVER commit your actual API keys or secrets to public version control.

# Apify Actor Integration
# Get your token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Groq LLM API
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# n8n Webhook Configuration (Cloud or Self-Hosted)
# Example: https://your-instance.app.n8n.cloud/webhook/linkedin-job-alert
N8N_WEBHOOK_URL=https://<your-n8n-instance>/webhook/linkedin-job-alert

# Google Sheets Integration
# Authenticated via OAuth2 in n8n (Google Cloud Console credentials)
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SHEET_NAME=Sheet1
